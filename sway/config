exec ibus-daemon -drx
# =============================

# BASIC SWAY CONFIG (MINIMAL)

# =============================

# Set mod key (Super/Windows key)

set $mod Mod4

# Applications

set $term wezterm
set $menu wofi --show drun

# Font

font pango:Berkeley Mono, monospace 10

# =============================

# OUTPUT / WALLPAPER

# =============================

output * bg ~/gruvbox-wallpapers/wallpapers/minimalistic/space.png fill

# =============================

# INPUT

# =============================

# Enable tap to click for touchpad

input type:touchpad {
tap enabled
natural_scroll enabled
}

# =============================

# KEYBINDINGS

# =============================

# Launch apps

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu

# Kill window

bindsym $mod+Shift+q kill

# Exit sway

bindsym $mod+Shift+e exec "swaymsg exit"

# Reload config

bindsym $mod+Shift+c reload

# Focus movement

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym Alt+Tab focus next
bindsym Alt+Shift+Tab focus prev

# Move windows

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Layout

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle

# Resize mode

mode "resize" {
bindsym h resize shrink width 10px
bindsym j resize grow height 10px
bindsym k resize shrink height 10px
bindsym l resize grow width 10px

bindsym Return mode "default"
bindsym Escape mode "default"

}
bindsym $mod+r mode "resize"

# Lock screen & Suspend
# Lock + suspend
bindsym $mod+Shift+s exec "swaylock -f -c 000000"

# Auto idle behavior
exec_always swayidle -w \
  timeout 300 'swaylock -f -c 000000' \
  before-sleep 'swaylock -f -c 000000'

# =============================

# WORKSPACES

# =============================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws3
bindsym $mod+Tab workspace back_and_forth

# Full screen
bindsym Print exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# Area select
bindsym Shift+Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# Clipboard
bindsym Ctrl+Print exec grim -g "$(slurp)" - | wl-copy

# =============================

# AUTOSTART

# =============================

# Waybar (status bar)

exec_always waybar

# Wallpaper (fallback if output fails)

exec_always swaybg -i ~/gruvbox-wallpapers/wallpapers/minimalistic/space.png -m fill

# Notifications (optional)

exec_always mako

# =============================

# GAPS (optional but nice)

# =============================

gaps inner 8
gaps outer 4

# =============================

# MISC

# =============================

focus_follows_mouse yes

default_border pixel 1
